# =============================================================================
# SEM Analysis Web App - Environment Configuration
# Copy this file to .env and adjust values as needed
# =============================================================================

# Application Settings
APP_NAME=SEM Analysis Tool
APP_VERSION=1.0.0
APP_PORT=3838

# Performance Limits
MAX_VARIABLES=200
MAX_OBSERVATIONS=100000
MAX_FILE_SIZE_MB=50
SESSION_TIMEOUT_MINUTES=30

# Logging
ENABLE_LOGGING=true
LOG_LEVEL=info

# Security
SHINY_SANITIZE_ERRORS=true

# Timezone
TZ=Asia/Tokyo
